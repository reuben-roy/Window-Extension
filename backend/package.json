{
  "name": "window-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "cf workers types && tsc -p tsconfig.worker.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "cf:build": "cf build",
    "cf:deploy": "cf deploy",
    "import:learning-quizzes": "node scripts/import_learning_quizzes.mjs",
    "validate:quiz-banks": "node scripts/validate_quiz_banks.mjs",
    "author:learning-quizzes": "python3 scripts/author_learning_quizzes.py"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.1",
    "@types/node": "^22.14.0",
    "cf": "^1.0.0-beta.18",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  }
}
