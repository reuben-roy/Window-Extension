NODE_ENV=production
PORT=8787
DATABASE_URL=postgresql://window:replace-me@postgres:5432/window?schema=public

# Keep mock for a smoke deployment. Use http or ssh only after configuring the
# matching OpenClaw settings below.
OPENCLAW_TRANSPORT=mock
OPENCLAW_HTTP_BASE_URL=
OPENCLAW_API_TOKEN=
OPENCLAW_SSH_HOST=
OPENCLAW_SSH_USER=
OPENCLAW_SSH_KEY_PATH=
OPENCLAW_REMOTE_BASE_URL=http://127.0.0.1:3000
OPENCLAW_FETCH_MODE=permissive
OPENCLAW_ALLOWED_HOST_SUFFIXES=
OPENCLAW_MOCK_LATENCY_MS=2500

GOOGLE_TOKENINFO_URL=https://www.googleapis.com/oauth2/v3/tokeninfo
WORKER_POLL_INTERVAL_MS=5000
